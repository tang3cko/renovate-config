{
  assignees: ["tang3cko"],
  reviewers: ["tang3cko"],

  extends: [
    "config:best-practices",

    // https://docs.renovatebot.com/presets-default/
    ":timezone(Asia/Tokyo)",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    'schedule:earlyMondays',

    // Keep biome.json $schema version in sync with @biomejs/biome package
    "customManagers:biomeVersions",
  ],

  // Automerge
  // automergeStrategy is intentionally omitted: it is silently ignored when
  // platformAutomerge=true (renovatebot/renovate#41177). GitHub repo merge
  // settings control the actual strategy instead.
  platformAutomerge: true,

  // Package rules
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },

    // https://docs.renovatebot.com/key-concepts/minimum-release-age/
    // config:best-practices ages only npm (security:minimumReleaseAgeNpm,
    // 3 days). Every other datasource (docker, github-actions, gomod, ...)
    // was automerged with no cooldown. This rule gives their version updates
    // the same 3 days. PRs still open immediately; the cooldown only holds the
    // renovate/stability-days status check pending until it elapses.
    //
    // Limited to major/minor/patch on purpose. Update types without a release
    // timestamp (lockFileMaintenance, pin, digest on registries that publish
    // none) never satisfy the default minimumReleaseAgeBehaviour, so the
    // stability check would stay pending forever:
    //   https://github.com/renovatebot/renovate/issues/45236
    //
    // matchDatasources negation:
    //   https://docs.renovatebot.com/string-pattern-matching/#negative-matching
    {
      matchDatasources: ["!npm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "3 days",
    },
    {
      // Skip Unity Editor version bumps: the version in ProjectVersion.txt requires every developer and CI machine to have that exact Unity Editor installed, so upgrades must be a deliberate manual decision rather than an automated update.
      matchManagers: ["unity3d"],
      enabled: false,
    },
  ],
}
